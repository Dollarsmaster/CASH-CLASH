# Backend (server/.env or hosting environment)
PORT=3001
# Comma-separated allowed frontend origins are supported.
CLIENT_ORIGIN=http://localhost:5173

# Frontend (client/.env)
VITE_SERVER_URL=http://localhost:3001

# Optional PostgreSQL match-history persistence
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set DATABASE_SSL=false only for a trusted local database
DATABASE_SSL=true
DB_POOL_SIZE=5

# Optional Redis active-room snapshot persistence / restart recovery
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Socket.IO Redis adapter (uses REDIS_URL; separate pub/sub connections)
# No extra variable is required.
